// Include the generated copy via install.sh --session (or --activate).
// Only MacShell's own application windows are affected.
window-rule {
    match app-id=r#"^(org\.quickshell|dev\.noctalia\.noctalia-qs)$"# title=r#"^(macshell Settings|Clock|Calculator|Notes|Reminders|Stickies( \[[0-9]+\])?)$"#
    open-floating true
}
layer-rule {
    match namespace="^macshell-wallpaper$"
    place-within-backdrop true
}
// Live window pixels under the glass. Xray true would blur only the wallpaper.
layer-rule {
    match namespace="^mac(bar|barbg|dock|spot|switch|wall|osd)$"
    background-effect { xray false; }
}
binds {
    Mod+Space { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "spotlight" "toggle"; }
    Mod+V { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "spotlight" "clipboard"; }
    Mod+Period { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "spotlight" "emoji"; }
    Mod+Shift+C { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "controlcenter" "toggle"; }
    Alt+Tab { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "switcher" "next"; }
    Alt+Shift+Tab { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "switcher" "prev"; }
    Print { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "screenshot" "region"; }
    Mod+Ctrl+W { spawn "qs" "-c" "MacShell-niri" "ipc" "call" "wallpapers" "toggle"; }
}
