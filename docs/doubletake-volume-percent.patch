+func audioVolumeBodyPercent(percent int) []byte {
+	if percent < 1 {
+		percent = 1
+	}
+	if percent > 100 {
+		percent = 100
+	}
+	if percent == 100 {
+		return []byte("volume: 0.000000\r\n")
+	}
+	db := -30 * (1 - float64(percent)/100)
+	return []byte(fmt.Sprintf("volume: %.6f\r\n", db))
+}
+
